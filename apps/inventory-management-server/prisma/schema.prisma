datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Products {
  category    Categories? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  createdAt   DateTime    @default(now())
  description String?
  id          String      @id @default(cuid())
  image       String?
  name        String?
  ordersItems Orders[]
  price       Float?
  quantity    Int?
  supplier    Suppliers?  @relation(fields: [supplierId], references: [id])
  supplierId  String?
  updatedAt   DateTime    @updatedAt
}

model Categories {
  createdAt      DateTime   @default(now())
  description    String?
  id             String     @id @default(cuid())
  name           String?
  parentCategory String?
  productsItems  Products[]
  updatedAt      DateTime   @updatedAt
}

model Orders {
  createdAt  DateTime  @default(now())
  id         String    @id @default(cuid())
  orderDate  DateTime?
  product    Products? @relation(fields: [productId], references: [id])
  productId  String?
  quantity   Int?
  totalPrice Float?
  updatedAt  DateTime  @updatedAt
}

model Suppliers {
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime   @default(now())
  id            String     @id @default(cuid())
  name          String?
  productsItems Products[]
  updatedAt     DateTime   @updatedAt
}
